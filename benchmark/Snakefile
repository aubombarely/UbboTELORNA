    params:
        genome = "{genome}",
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/compare_annotations.py "
        "  --predicted {input.ubbo} "
        "  --tidk_tsv  {input.tidk} "
        "  --feature   telomere "
        "  --tool      ubbotelorna_nhmmer "
        "  --genome    {params.genome} "
        "  --threshold {config[overlap_threshold]} "
        "  --output    {output.tsv}"


