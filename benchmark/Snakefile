# 6. Robustness benchmark
# ═══════════════════════════════════════════════════════════════════════════

rule create_adversarial:
    input:
        fasta = genome_fasta,
    output:
        fasta = "{res}/robustness/{genome}/{genome}_adversarial.fasta",
    params:
        repeat   = lambda wc: config["genomes"][wc.genome]["telomere_repeat"],
        n_copies = config["adversarial_n_repeats"],
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/create_adversarial.py "
        "  --fasta {input.fasta} "
        "  --repeat {params.repeat} "
        "  --n_copies {params.n_copies} "
        "  --output {output.fasta}"


rule create_fragmented:
    input:
        fasta = genome_fasta,
    output:
        fasta = "{res}/robustness/{genome}/{genome}_fragmented.fasta",
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/create_adversarial.py "
        "  --fasta {input.fasta} "
        "  --fragment_size 10000 "
        "  --output {output.fasta}"


rule run_ubbotelorna_adversarial:
