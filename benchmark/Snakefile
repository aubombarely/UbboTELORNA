rule robustness_summary:
    input:
        native_ubbo      = lambda wc: f"{wc.res}/annotations/{wc.genome}/ubbotelorna_nhmmer/{wc.genome}.gff3",
        native_barrnap   = lambda wc: f"{wc.res}/annotations/{wc.genome}/barrnap/{wc.genome}.gff3",
        advers_ubbo      = "{res}/robustness/{genome}/ubbotelorna_adversarial.gff3",
        advers_barrnap   = "{res}/robustness/{genome}/barrnap_adversarial.gff3",
        fragment_ubbo    = "{res}/robustness/{genome}/ubbotelorna_fragmented.gff3",
        fragment_barrnap = "{res}/robustness/{genome}/barrnap_fragmented.gff3",
        reference        = lambda wc: f"{wc.res}/genomes/{wc.genome}/{wc.genome}_ref.gff3"
                           if config["genomes"][wc.genome].get("has_refseq_gff")
                           else [],
    output:
        tsv = "{res}/robustness/{genome}/robustness_summary.tsv",
    params:
        genome    = "{genome}",
        threshold = config["overlap_threshold"],
        has_ref   = lambda wc: str(config["genomes"][wc.genome].get("has_refseq_gff", False)),
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/compare_annotations.py "
        "  --robustness_mode "
        "  --native_ubbo    {input.native_ubbo} "
        "  --native_barrnap {input.native_barrnap} "
        "  --advers_ubbo    {input.advers_ubbo} "
        "  --advers_barrnap {input.advers_barrnap} "
        "  --fragment_ubbo  {input.fragment_ubbo} "
        "  --fragment_barrnap {input.fragment_barrnap} "
        "  --genome   {params.genome} "
        "  --threshold {params.threshold} "
        "  --output    {output.tsv}"


# ═══════════════════════════════════════════════════════════════════════════
# 7. Performance benchmark (thread sweep)
# ═══════════════════════════════════════════════════════════════════════════

rule perf_ubbotelorna_sweep:
    input:
        fasta = genome_fasta,
    output:
        done = touch("{res}/performance/{genome}/ubbotelorna_t{nthreads}.done"),
    params:
        kingdom = lambda wc: config["genomes"][wc.genome]["kingdom"],
        outdir  = "{res}/performance/{genome}/ubbotelorna_t{nthreads}_run",
        script  = config["ubbotelorna_script"],
    threads: lambda wc: int(wc.nthreads)
    benchmark:
        "{res}/performance/{genome}/ubbotelorna_nhmmer_t{nthreads}.benchmark.tsv"
    log:
        "{res}/performance/{genome}/ubbotelorna_t{nthreads}.log"
    conda:
        "../envs/UbboTELORNA.yaml"
    shell:
        """
        rm -rf {params.outdir}
        python3 {params.script} \
            --fasta {input.fasta} \
            --output {params.outdir} \
            --kingdom {params.kingdom} \
            --threads {threads} \
            --disable_co2_tracking \
            --skip_module 1,6,7 \
            --force \
            > {log} 2>&1
        """


rule perf_barrnap_sweep:
    input:
        fasta = genome_fasta,
    output:
        done = touch("{res}/performance/{genome}/barrnap_t{nthreads}.done"),
    params:
        kingdom = lambda wc: config["genomes"][wc.genome]["barrnap_kingdom"],
        gff3    = "{res}/performance/{genome}/barrnap_t{nthreads}.gff3",
    threads: lambda wc: int(wc.nthreads)
    benchmark:
        "{res}/performance/{genome}/barrnap_t{nthreads}.benchmark.tsv"
    log:
        "{res}/performance/{genome}/barrnap_t{nthreads}.log"
    conda:
        "envs/benchmark.yaml"
    shell:
        "barrnap --kingdom {params.kingdom} --threads {threads} "
        "  {input.fasta} > {params.gff3} 2> {log}"


rule perf_trnascan_sweep:
    input:
        fasta = genome_fasta,
    output:
        done = touch("{res}/performance/{genome}/trnascan_t{nthreads}.done"),
    params:
        mode = lambda wc: config["genomes"][wc.genome]["trnascan_mode"],
        gff3 = "{res}/performance/{genome}/trnascan_t{nthreads}.gff3",
    threads: lambda wc: int(wc.nthreads)
    benchmark:
        "{res}/performance/{genome}/trnascan_t{nthreads}.benchmark.tsv"
    log:
        "{res}/performance/{genome}/trnascan_t{nthreads}.log"
    conda:
        "envs/benchmark.yaml"
    shell:
        "rm -f {params.gff3} && "
        "tRNAscan-SE {params.mode} --thread {threads} "
        "  --gff {params.gff3} {input.fasta} > {log} 2>&1"


rule perf_summary:
    input:
        ubbo    = expand("{{res}}/performance/{{genome}}/ubbotelorna_nhmmer_t{t}.benchmark.tsv",
                         t=config["performance_threads"]),
        barrnap = expand("{{res}}/performance/{{genome}}/barrnap_t{t}.benchmark.tsv",
                         t=config["performance_threads"]),
        trnascan = expand("{{res}}/performance/{{genome}}/trnascan_t{t}.benchmark.tsv",
                          t=config["performance_threads"]),
    output:
        tsv = "{res}/performance/{genome}/perf_summary.tsv",
    params:
        genome  = "{genome}",
        threads = config["performance_threads"],
    run:
        import csv, os
        rows = []
        tools = {
            "ubbotelorna_nhmmer": input.ubbo,
            "barrnap":            input.barrnap,
            "trnascan":           input.trnascan,
        }
        for tool, files in tools.items():
            for t, f in zip(params.threads, files):
                if not os.path.exists(f):
                    continue
                with open(f) as fh:
                    reader = csv.DictReader(fh, delimiter="\t")
                    for row in reader:
                        rows.append({
                            "genome":    params.genome,
                            "tool":      tool,
                            "threads":   t,
                            "s":         row.get("s", ""),
                            "max_rss":   row.get("max_rss", ""),
                            "cpu_time":  row.get("cpu_time", ""),
                        })
        with open(output.tsv, "w", newline="") as fh:
            writer = csv.DictWriter(fh, fieldnames=["genome","tool","threads","s","max_rss","cpu_time"],
                                    delimiter="\t")
            writer.writeheader()
            writer.writerows(rows)


# ═══════════════════════════════════════════════════════════════════════════
# 8. Final report
# ═══════════════════════════════════════════════════════════════════════════

rule benchmark_report:
    input:
        correctness = expand("{res}/metrics/{genome}/ubbotelorna_nhmmer_rrna_metrics.tsv",
                             res=config["results_dir"], genome=genomes_with_ref()),
        robustness  = expand("{res}/robustness/{genome}/robustness_summary.tsv",
                             res=config["results_dir"],
                             genome=config["adversarial_genomes"]),
        performance = expand("{res}/performance/{genome}/perf_summary.tsv",
                             res=config["results_dir"],
                             genome=config["performance_genomes"]),
    output:
        pdf = "{res}/figures/benchmark_report.pdf",
        png = "{res}/figures/benchmark_report.png",
    params:
        metrics_dir    = f"{config['results_dir']}/metrics",
        robustness_dir = f"{config['results_dir']}/robustness",
        perf_dir       = f"{config['results_dir']}/performance",
        out_base       = f"{config['results_dir']}/figures/benchmark_report",
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/benchmark_report.py "
        "  --metrics_dir    {params.metrics_dir} "
        "  --robustness_dir {params.robustness_dir} "
        "  --perf_dir       {params.perf_dir} "
        "  --output         {params.out_base}"
