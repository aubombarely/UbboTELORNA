# 3. Run tools — tRNA
# ═══════════════════════════════════════════════════════════════════════════

rule run_trnascan:
    input:
        fasta = genome_fasta,
    output:
        gff3 = "{res}/annotations/{genome}/trnascan/{genome}_raw.gff3",
        stats = "{res}/annotations/{genome}/trnascan/{genome}_stats.txt",
    params:
        mode = lambda wc: config["genomes"][wc.genome]["trnascan_mode"],
    threads: config["default_threads"]
    log:
        "{res}/annotations/{genome}/trnascan/{genome}.log"
    conda:
        "envs/benchmark.yaml"
    shell:
        "tRNAscan-SE {params.mode} --thread {threads} "
        "  --gff {output.gff3} -m {output.stats} "
        "  {input.fasta} > {log} 2>&1"


rule normalise_trnascan:
    input:
        gff3 = "{res}/annotations/{genome}/trnascan/{genome}_raw.gff3",
    output:
        gff3 = "{res}/annotations/{genome}/trnascan/{genome}.gff3",
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/normalise_gff3.py --tool trnascan "
        "  --input {input.gff3} --output {output.gff3}"


# ═══════════════════════════════════════════════════════════════════════════
# 4. Run tools — telomere
# ═══════════════════════════════════════════════════════════════════════════

rule run_tidk:
    input:
        fasta = genome_fasta,
    output:
        tsv = "{res}/annotations/{genome}/tidk/{genome}_telomeric_repeat_windows.tsv",
    params:
        repeat = lambda wc: config["genomes"][wc.genome]["telomere_repeat"],
        outdir = "{res}/annotations/{genome}/tidk",
        prefix = "{genome}",
    log:
        "{res}/annotations/{genome}/tidk/{genome}.log"
    conda:
        "envs/benchmark.yaml"
    run:
        import subprocess, shutil, os
        rep = params.repeat
        os.makedirs(params.outdir, exist_ok=True)
        if rep == "auto":
            # explore now writes to stdout; --minimum/--maximum must be
            # passed explicitly even though they have defaults in newer tidk
            r = subprocess.run(
                ["tidk", "explore", "--minimum", "5", "--maximum", "12", input.fasta],
                capture_output=True, text=True
            )
            with open(log[0], "w") as fh:
                fh.write(r.stdout + r.stderr)
            if r.returncode != 0:
                raise RuntimeError(f"tidk explore failed:\n{r.stderr}")
            # stdout: header line then data rows; first column is the kmer sequence
            # pick first row whose first column contains only ACGT characters
            rep = None
            for line in r.stdout.splitlines():
                cols = line.strip().split("\t")
                if cols and cols[0] and all(c in "ACGTacgt" for c in cols[0]):
                    rep = cols[0].upper()
                    break
            if rep is None:
                raise RuntimeError(
                    f"tidk explore found no telomeric repeat in {input.fasta}.\n"
                    f"stdout:\n{r.stdout}"
                )
        else:
            open(log[0], "w").close()  # create empty log for non-auto path
        # search: FASTA is now positional; --output is filename prefix; --dir is directory
        r2 = subprocess.run(
            ["tidk", "search",
             "--string", rep,
             "--output", params.prefix,
             "--dir",    params.outdir,
             input.fasta],
            capture_output=True, text=True
        )
        with open(log[0], "a") as fh:
            fh.write(r2.stdout + r2.stderr)
        if r2.returncode != 0:
            raise RuntimeError(f"tidk search failed:\n{r2.stderr}")


