# 2. Run tools — rRNA
# ═══════════════════════════════════════════════════════════════════════════

rule run_ubbotelorna_nhmmer:
    input:
        fasta = genome_fasta,
    output:
        gff3 = "{res}/annotations/{genome}/ubbotelorna_nhmmer/{genome}.gff3",
    params:
        kingdom = lambda wc: config["genomes"][wc.genome]["kingdom"],
        outdir  = "{res}/annotations/{genome}/ubbotelorna_nhmmer/run",
        script  = config["ubbotelorna_script"],
    threads: config["default_threads"]
    log:
        "{res}/annotations/{genome}/ubbotelorna_nhmmer/{genome}.log"
    conda:
        "../envs/UbboTELORNA.yaml"
    shell:
        """
        python3 {params.script} \
            --fasta {input.fasta} \
            --output {params.outdir} \
            --kingdom {params.kingdom} \
            --search_tool nhmmer \
            --threads {threads} \
            --disable_co2_tracking \
            --skip_module 1,6,7 \
            > {log} 2>&1
        cp {params.outdir}/results/mod05_annotation_*.gff3 {output.gff3}
        """


