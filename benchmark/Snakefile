# UbboTELORNA benchmark Snakefile
# ─────────────────────────────────────────────────────────────────────────────
# Three benchmark dimensions:
#   1. Correctness  — sensitivity, precision, F1 vs. RefSeq GFF3
#   2. Robustness   — adversarial telomere-prefix test + fragmented assembly
#   3. Performance  — wall-clock time and peak RSS at varied thread counts
#
# Quick start:
#   conda activate ubbotelorna_bench
#   snakemake --cores 16 --use-conda all
#
# Download only:
#   snakemake --cores 4 --use-conda download_all
#
# Single genome:
#   snakemake --cores 8 results/metrics/athaliana/ubbotelorna_nhmmer_rrna_metrics.tsv

configfile: "config.yaml"

from pathlib import Path

# ── helper: all genomes that have a RefSeq GFF3 ────────────────────────────
def genomes_with_ref():
    return [g for g, v in config["genomes"].items() if v.get("has_refseq_gff")]

def all_genomes():
    return list(config["genomes"].keys())

# ── genome FASTA path (downloaded or user-provided) ─────────────────────────
def genome_fasta(wildcards):
    g = wildcards.genome
    local = config["genomes"][g].get("fasta_path")
    if local:
        return local
    return f"{config['results_dir']}/genomes/{g}/{g}.fasta"

# ═══════════════════════════════════════════════════════════════════════════
# Target rules
# ═══════════════════════════════════════════════════════════════════════════

rule all:
    input:
        # correctness metrics (all tools, all genomes with reference)
        expand("{res}/metrics/{genome}/ubbotelorna_nhmmer_rrna_metrics.tsv",
               res=config["results_dir"], genome=genomes_with_ref()),
        expand("{res}/metrics/{genome}/ubbotelorna_cmsearch_rrna_metrics.tsv",
               res=config["results_dir"], genome=genomes_with_ref()),
        expand("{res}/metrics/{genome}/barrnap_rrna_metrics.tsv",
               res=config["results_dir"], genome=genomes_with_ref()),
        expand("{res}/metrics/{genome}/ubbotelorna_trna_metrics.tsv",
               res=config["results_dir"], genome=genomes_with_ref()),
        expand("{res}/metrics/{genome}/trnascan_trna_metrics.tsv",
               res=config["results_dir"], genome=genomes_with_ref()),
        # telomere comparison (no reference; tool-vs-tool)
        expand("{res}/metrics/{genome}/telomere_comparison.tsv",
               res=config["results_dir"],
               genome=[g for g in all_genomes()
                       if config["genomes"][g].get("telomere_repeat")]),
        # adversarial robustness
        expand("{res}/robustness/{genome}/robustness_summary.tsv",
               res=config["results_dir"],
               genome=config["adversarial_genomes"]),
        # performance
        expand("{res}/performance/{genome}/perf_summary.tsv",
               res=config["results_dir"],
               genome=config["performance_genomes"]),
        # final report
        f"{config['results_dir']}/figures/benchmark_report.pdf",


rule download_all:
    input:
        expand("{res}/genomes/{genome}/{genome}.fasta",
               res=config["results_dir"],
               genome=[g for g in all_genomes()
                       if config["genomes"][g].get("accession")]),


# ═══════════════════════════════════════════════════════════════════════════
# 1. Download genomes
# ═══════════════════════════════════════════════════════════════════════════

rule download_genome:
    output:
        fasta = "{res}/genomes/{genome}/{genome}.fasta",
        gff3  = "{res}/genomes/{genome}/{genome}_ref.gff3",
    params:
        accession = lambda wc: config["genomes"][wc.genome]["accession"],
        ncbi_group = lambda wc: config["genomes"][wc.genome]["ncbi_group"],
        outdir    = lambda wc: f"{wc.res}/genomes/{wc.genome}",
        genome    = lambda wc: wc.genome,
    log:
        "{res}/genomes/{genome}/{genome}_download.log",
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/download_genomes.py "
        "  --accession {params.accession} "
        "  --group {params.ncbi_group} "
        "  --outdir {params.outdir} "
        "  --genome {params.genome} "
        "  > {log} 2>&1"


