# 5. Correctness metrics
# ═══════════════════════════════════════════════════════════════════════════

rule compare_rrna_ubbotelorna_nhmmer:
    input:
        predicted = "{res}/annotations/{genome}/ubbotelorna_nhmmer/{genome}.gff3",
        reference = "{res}/genomes/{genome}/{genome}_ref.gff3",
    output:
        tsv = "{res}/metrics/{genome}/ubbotelorna_nhmmer_rrna_metrics.tsv",
    params:
        tool     = "ubbotelorna_nhmmer",
        feature  = "rRNA",
        threshold = config["overlap_threshold"],
    conda:
        "envs/benchmark.yaml"
    shell:
        "python3 scripts/compare_annotations.py "
        "  --predicted {input.predicted} "
        "  --reference {input.reference} "
        "  --feature {params.feature} "
        "  --tool {params.tool} "
        "  --genome {wildcards.genome} "
        "  --threshold {params.threshold} "
        "  --output {output.tsv}"


